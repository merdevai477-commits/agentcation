// Agentication — phase 2: User + Organization + Agent + Model
// Source ERD: https://app.eraser.io/workspace/tKfCWwPUVUb6MYAbhGek
// Full frozen shape: backend/docs/erd-shape.json

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// المستخدم [منفّذ — Clerk]
model User {
  /// المعرف — Clerk user id (varchar pk)
  id        String   @id @db.VarChar(255)
  /// البريد
  email     String   @db.VarChar(255)
  /// الاسم
  name      String   @db.VarChar(255)
  /// تاريخ_الإنشاء
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]

  @@map("users")
}

/// المنظمة
model Organization {
  /// المعرف
  id        String   @id @default(uuid()) @db.Uuid
  /// الاسم
  name      String   @db.VarChar(255)
  /// تاريخ_الإنشاء
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  agents           Agent[]
  whatsappSession  WhatsAppSession?
  businessStory    BusinessStory?
  bizConversations BizConversation[]

  @@map("organizations")
}

/// عضوية_المنظمة
model OrganizationMembership {
  /// المعرف
  id             String @id @default(uuid()) @db.Uuid
  /// معرف_المستخدم
  userId         String @map("user_id") @db.VarChar(255)
  /// معرف_المنظمة
  organizationId String @map("organization_id") @db.Uuid
  /// الدور
  role           String @db.VarChar(64)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// الوكيل — تخزين الوكلاء
model Agent {
  /// المعرف
  id             String @id @default(uuid()) @db.Uuid
  /// معرف_المنظمة
  organizationId String @map("organization_id") @db.Uuid
  /// الاسم
  name           String @db.VarChar(255)
  /// الحالة
  status         String @db.VarChar(64)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     AgentVersion[]

  @@index([organizationId])
  @@map("agents")
}

/// إصدار_الوكيل — يربط الوكيل بالنموذج
model AgentVersion {
  /// المعرف
  id            String @id @default(uuid()) @db.Uuid
  /// معرف_الوكيل
  agentId       String @map("agent_id") @db.Uuid
  /// رقم_الإصدار
  versionNumber Int    @map("version_number")
  /// معرف_النموذج
  modelId       String @map("model_id") @db.Uuid

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id])

  @@unique([agentId, versionNumber])
  @@index([modelId])
  @@map("agent_versions")
}

/// النموذج / Models
model Model {
  /// المعرف
  id       String @id @default(uuid()) @db.Uuid
  /// الاسم
  name     String @db.VarChar(255)
  /// مفتاح_النموذج
  modelKey String @map("model_key") @db.VarChar(255)

  versions AgentVersion[]

  @@unique([modelKey])
  @@map("models")
}

/// جلسة واتساب (Baileys — جهاز مرتبط)
model WhatsAppSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  status         String    @default("stopped") @db.VarChar(32)
  phoneE164      String?   @map("phone_e164") @db.VarChar(32)
  displayName    String?   @map("display_name") @db.VarChar(255)
  authDir        String    @map("auth_dir") @db.VarChar(512)
  lastQrAt       DateTime? @map("last_qr_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

/// قصة البيزنز (JSON) — سياق الردود للـ LLM
model BusinessStory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_stories")
}

model BizConversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  platform       String   @default("whatsapp") @db.VarChar(32)
  remoteJid      String   @map("remote_jid") @db.VarChar(128)
  contactName    String?  @map("contact_name") @db.VarChar(255)
  preview        String?  @db.VarChar(512)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     BizMessage[]

  @@unique([organizationId, platform, remoteJid])
  @@index([organizationId, updatedAt])
  @@map("biz_conversations")
}

model BizMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(16)
  text           String   @db.Text
  waMessageId    String?  @map("wa_message_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation BizConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("biz_messages")
}
